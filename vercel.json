{
  "crons": [
    {
      "path": "/api/cron-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/analyze",
      "schedule": "30 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}